server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/css application/javascript text/html image/svg+xml;

    location / {
        try_files $uri $uri/ =404;
    }

    # Long-cache static assets — they're versioned by filename if needed.
    location ~* \.(css|js|mp4|jpg|jpeg|png|svg|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # No cache on index.html so deploys propagate immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
